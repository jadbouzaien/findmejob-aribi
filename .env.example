# Postgres : choisis un mot de passe (ex : openssl rand -hex 24) et reporte-le dans DATABASE_URL
POSTGRES_USER=findmejob
POSTGRES_PASSWORD=
POSTGRES_DB=findmejob
DATABASE_URL=postgres://findmejob:CHANGE_ME@localhost:5434/findmejob
TELEGRAM_BOT_TOKEN=
# Rempli automatiquement quand tu envoies /start au bot (stocké en base). Tu peux aussi le forcer ici.
TELEGRAM_CHAT_ID=
# URL du tableau, utilisée dans les messages Telegram
DASHBOARD_URL=http://localhost:3101

# Coordonnées affichées sur les lettres de motivation
ME_NAME=Prénom Nom
ME_ADDRESS=Dubaï, Émirats arabes unis
ME_CITY_EN=Dubai, UAE
ME_PHONE=+971 50 000 0000
ME_PHONE_INTL=+971 50 000 0000
ME_EMAIL=you@example.com
ME_LINKEDIN=linkedin.com/in/your-profile

# Salaire MENSUEL en AED (norme aux Émirats) : plancher et seuil "bon salaire". Vide = pas de plancher.
SALARY_MIN_AED=
SALARY_GOOD_AED=

# Permis de conduire émirien : "true" s'il l'a (sinon les offres qui l'exigent perdent 10 pts)
HAS_UAE_DRIVING_LICENSE=

# Careerjet (agrégateur couvrant les Émirats) : identifiant partenaire gratuit sur https://www.careerjet.com/partners/
# Sans identifiant, la source est désactivée. CAREERJET_REFERER = site déclaré chez Careerjet (sans port).
CAREERJET_AFFID=
CAREERJET_REFERER=
